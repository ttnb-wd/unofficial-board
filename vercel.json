{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "rewrites": [
    { "source": "/mini-app", "destination": "/mini-app/index.html" },
    { "source": "/mini-app/bills", "destination": "/mini-app/bills.html" },
    { "source": "/mini-app/birthday", "destination": "/mini-app/birthday.html" },
    { "source": "/mini-app/countdown", "destination": "/mini-app/countdown.html" }
  ],
  "headers": [
    {
      "source": "/mini-app(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; connect-src 'self' https:; img-src 'self' data: blob:; base-uri 'none'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
